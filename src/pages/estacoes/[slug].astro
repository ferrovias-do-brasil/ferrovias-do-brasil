---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Claims from '../../components/Claims.astro';
import SourceLink from '../../components/SourceLink.astro';
import { preferredClaim } from '../../lib/claims';
import { formatDatePt } from '../../lib/dates';

export async function getStaticPaths() {
  const stations = await getCollection('stations');
  return stations.map((station) => ({ params: { slug: station.id }, props: { station } }));
}

const { station } = Astro.props;
const { data } = station;
const { Content } = await render(station);
const base = import.meta.env.BASE_URL;
const openedYear = preferredClaim(data.opened).value.slice(0, 4);
const events = (await getCollection('events', (e) => e.data.stations.includes(station.id))).sort((a, b) =>
  a.data.date.localeCompare(b.data.date),
);
const allSources = new Set<string>([
  ...data.opened.map((c) => c.source),
  ...(data.passenger_end ?? []).map((c) => c.source),
  ...(data.closed ?? []).map((c) => c.source),
  ...(data.km ?? []).map((k) => k.source),
  ...data.sites.flatMap((s) => s.sources),
  ...events.flatMap((e) => e.data.sources),
  ...data.sources,
]);
const confidence = { high: 'alta', medium: 'média', low: 'baixa' } as const;
---

<Base title={`Estação ${data.name}`} description={data.summary}>
  <article class="prose">
    <p class="muted"><a href={`${base}estacoes/`}>Estações</a> · E.F. Noroeste do Brasil</p>
    <h1>{data.name}</h1>
    <p class="lead">{data.summary}</p>
    <p><a href={`${base}?ano=${openedYear}&sel=station:${station.id}`}>Ver no mapa em {openedYear} →</a></p>

    <h2>Datas</h2>
    <h3>Inauguração</h3>
    <Claims claims={data.opened} />
    {data.passenger_end && (<><h3>Fim dos trens de passageiros</h3><Claims claims={data.passenger_end} /></>)}
    {data.closed && (<><h3>Fechamento</h3><Claims claims={data.closed} /></>)}

    {
      data.km && (
        <>
          <h3>Quilometragem</h3>
          <ul>
            {data.km.map((k) => (
              <li>
                km {k.value.toLocaleString('pt-BR')} ({k.year}) — <SourceLink id={k.source} />
                {k.note && <span class="muted"> {k.note}</span>}
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h3>Localização</h3>
    <table>
      <thead><tr><th>Período</th><th>Coordenadas</th><th>Confiança</th><th>Observação</th></tr></thead>
      <tbody>
        {
          data.sites.map((s) => (
            <tr>
              <td>{formatDatePt(s.from)} – {s.to ? formatDatePt(s.to) : 'hoje'}</td>
              <td><code>{s.coords[1].toFixed(5)}, {s.coords[0].toFixed(5)}</code></td>
              <td>{confidence[s.confidence]}</td>
              <td class="muted">{s.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <Content />

    {
      events.length > 0 && (
        <>
          <h2>Cronologia</h2>
          <ul>
            {events.map((e) => (
              <li>
                <strong>{formatDatePt(e.data.date, e.data.circa)}</strong> — {e.data.title}. <span class="muted">{e.data.summary}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2>Fontes</h2>
    <ul>{[...allSources].map((id) => <li><SourceLink id={id} /></li>)}</ul>
    <p class="muted">
      Encontrou um erro ou tem um documento sobre esta estação? <a href={`${base}contribuir/`}>Contribua</a>.
    </p>
  </article>
</Base>

<style>
  .lead {
    font-size: 1.1rem;
  }
</style>
